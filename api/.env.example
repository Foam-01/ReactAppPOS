# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit .env)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# สุ่มใหม่ด้วย: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
TOKEN_SECRET=
TOKEN_EXPIRES_IN=1d

# โดเมนหน้าเว็บที่อนุญาตให้เรียก API (คั่นด้วย ,)
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# ใช้กับ docker-compose
POSTGRES_PASSWORD=
